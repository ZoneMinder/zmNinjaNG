<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/app_icon_flat"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:banner="@drawable/app_icon_flat"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PipActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar"
        />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Analytics is not used. The Analytics/Measurement SDK is not a
             dependency (only firebase-messaging, which pulls the dormant
             measurement-connector interface). These flags declare analytics off so
             nothing is collected even if the Analytics SDK is ever added. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />

        <!-- Route FCM notification messages that omit a channel_id (the ZM event
             server does not set one) to our high-importance "zmninja-ng" channel
             instead of FCM's default "Miscellaneous" fallback channel, so alerts
             show a heads-up banner. Must match the id in
             services/pushNotifications.ts createChannel(). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="zmninja-ng" />
    </application>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor-community/media saves downloads to the app's own gallery album
         via MediaStore. In basic (non-gallery) mode it requests no storage/media
         permissions, so READ_MEDIA_IMAGES/READ_MEDIA_VIDEO and the legacy
         external-storage permissions are not declared. Google Play rejects
         READ_MEDIA_* unless broad library access is the core purpose (refs #190). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
