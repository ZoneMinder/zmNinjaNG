{
  "name": "zmNinjaNG",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k -s first \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "electron:start": "npm run build && electron electron/main.cjs",
    "electron:build": "bash ../scripts/build-desktop-electron.sh",
    "electron:build:nosign": "bash ../scripts/build-desktop-electron.sh --nosign",
    "proxy": "node proxy-server.js",
    "dev:all": "npm run proxy & npm run dev",
    "mock:notifications": "node mock-notification-server.js",
    "dev:notifications": "npm run proxy & npm run mock:notifications & npm run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:a11y": "eslint -c eslint.a11y.config.js .",
    "lint:correctness": "eslint -c eslint.correctness.config.js .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "gates": "vitest run && npm run build && npm run lint:a11y && npm run lint:correctness && npm run lint:ratchet",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:android": "bash ../scripts/test-android.sh",
    "test:e2e:ios-phone": "bash ../scripts/test-ios.sh phone",
    "test:e2e:ios-tablet": "bash ../scripts/test-ios.sh tablet",
    "test:e2e:all-platforms": "bash ../scripts/test-all-platforms.sh",
    "test:screenshots:ios-phone": "TEST_DEVICE=ios-phone npx wdio run wdio.config.device-screenshots.ts",
    "test:screenshots:ios-tablet": "TEST_DEVICE=ios-tablet npx wdio run wdio.config.device-screenshots.ts",
    "test:screenshots:android": "TEST_DEVICE=android npx wdio run wdio.config.device-screenshots.ts",
    "test:platform:setup": "tsx ../scripts/verify-platform-setup.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "analyze": "npm run build && open dist/stats.html",
    "android:sync": "node ../scripts/sync-version.js && npm run build && npx cap sync android",
    "android:run": "npx cap run android",
    "android": "npm run android:sync && npm run android:run",
    "android:open": "npx cap open android",
    "android:logs": "$ANDROID_HOME/platform-tools/adb logcat | grep -E '(Capacitor|Console|chromium)'",
    "android:devices": "$ANDROID_HOME/platform-tools/adb devices",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "android:bundle": "cd android && ./gradlew bundleRelease && cd ..",
    "ios:sync": "node ../scripts/sync-version.js && npm run build && npx cap sync ios",
    "ios:run": "npx cap run ios",
    "ios": "npm run ios:sync && npm run ios:run",
    "ios:open": "npx cap open ios",
    "icons": "capacitor-assets generate --ios --android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.102.5",
    "@use-gesture/react": "^10.3.1",
    "capacitor-barcode-scanner": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.18.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^1.5.2",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^16.3.5",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "video.js": "^8.24.0",
    "videojs-markers": "^1.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-grid-layout": "^1.3.6",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@wdio/appium-service": "^9.31.3",
    "@wdio/cli": "^9.31.3",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.26.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "express": "^5.1.0",
    "globals": "^16.5.0",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^27.0.1",
    "playwright": "^1.57.0",
    "playwright-bdd": "^8.4.2",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0",
    "webdriverio": "^9.26.1",
    "ws": "^8.21.3"
  }
}
